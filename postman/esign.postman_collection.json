    {
      "name": "1. Загрузка ключа (Ф-1)",
      "item": [
        {
          "name": "Шаг 1 — контейнер без PIN",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/keys/uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "keys",
                "uploads"
              ]
            },
            "description": "Выберите PFX в поле container. upload_id сохранится в переменную коллекции.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "container",
                  "type": "file",
                  "src": [],
                  "description": "PFX-файл ключа"
                },
                {
                  "key": "key_type",
                  "value": "organization",
                  "type": "text",
                  "description": "organization | employee"
                },
                {
                  "key": "owner_login",
                  "value": "",
                  "type": "text",
                  "description": "для employee"
                },
                {
                  "key": "clients",
                  "value": "[{\"id\":\"1c-erp\",\"sign\":true,\"decrypt\":true}]",
                  "type": "text",
                  "description": "системы и их права"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.upload_id) pm.collectionVariables.set('uploadId', j.upload_id);",
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Шаг 2 — PIN",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/keys/uploads/{{uploadId}}/pin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "keys",
                "uploads",
                "{{uploadId}}",
                "pin"
              ]
            },
            "description": "В тестовом режиме — открытый PIN. Отпечаток сохранится в переменную thumbprint.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{pin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.thumbprint) pm.collectionVariables.set('thumbprint', j.thumbprint);",
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
